<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="ProdPU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>se.edugrade.entities.Users</class>
        <class>se.edugrade.entities.Comment</class>
        <class>se.edugrade.entities.Hashtag</class>
        <class>se.edugrade.entities.ImagePost</class>
        <class>se.edugrade.entities.Like</class>
        <class>se.edugrade.entities.LinkPost</class>
        <class>se.edugrade.entities.Post</class>
        <class>se.edugrade.entities.TextPost</class>
        <class>se.edugrade.entities.VideoPost</class>

        <properties>
            <!-- H2 File-based Database (PRODUKTIONSLÄGE) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./data/smdb"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- HikariCP Connection Pooling -->
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.minimumIdle" value="5"/>
            <property name="hibernate.hikari.maximumPoolSize" value="20"/>
            <property name="hibernate.hikari.idleTimeout" value="300000"/>

            <!-- Hibernate Properties -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>


        </properties>
    </persistence-unit>
</persistence>